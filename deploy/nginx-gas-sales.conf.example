# ============================================================
# Nginx reverse proxy + HTTPS (production)
# ============================================================
# API + frontend tĩnh do backend phục vụ trên :4000.
# Bạn chỉ cần forward 443 -> 4000, không mở port 4000 ra ngoài.
#
# Bước:
#   1. Đặt file này vào /etc/nginx/conf.d/gas-sales.conf
#   2. Sửa "shop.example.com" thành domain thật
#   3. Cài HTTPS bằng certbot (Let's Encrypt):
#        sudo apt install certbot python3-certbot-nginx
#        sudo certbot --nginx -d shop.example.com
#   4. sudo nginx -t && sudo systemctl reload nginx
# ============================================================

server {
    listen 80;
    server_name shop.example.com;
    # Tự chuyển HTTP -> HTTPS (sau khi cài certbot sẽ tự thêm)
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name shop.example.com;

    # Nếu dùng certbot, hãy bỏ comment các dòng ssl dưới đây
    # (certbot thường tự chèn vào block server 443):
    # ssl_certificate     /etc/letsencrypt/live/shop.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/shop.example.com/privkey.pem;

    client_max_body_size 15m;   # phải >= body limit của backend (nhớ cấu hình CORS cho ảnh)

    # Backend (Express) — chạy bằng systemd/PM2 trên cổng này
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
