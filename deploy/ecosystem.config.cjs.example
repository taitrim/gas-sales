{
  "name": "gas-sales-backend",
  "script": "src/server.js",
  "cwd": "/srv/gas-sales-backend",
  "env": {
    "NODE_ENV": "production"
  },
  "env_file": "/srv/gas-sales-backend/.env",
  "instances": 1,
  "exec_mode": "fork",
  "max_memory_restart": "512M",
  "autorestart": true,
  "watch": false,
  "merge_logs": true,
  "log_file": "/var/log/gas-sales/out.log",
  "error_file": "/var/log/gas-sales/error.log",
  "time": true
}
