# Server
PORT=4000
# Môi trường: development | production (production sẽ kiểm tra JWT_SECRET nghiêm ngặt hơn)
NODE_ENV=development
# Secret dùng để ký JWT — TRONG PRODUCTION PHẢI LÀ CHUỖI NGẪU NHIÊN, dài ≥64 ký tự.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=7d

# MySQL — KHÔNG dùng root khi deploy. Tạo user riêng: CREATE USER 'gas'@'localhost' IDENTIFIED BY 'mat-khau-manh';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gas_sales
DB_CONNECTION_LIMIT=10

# CORS - danh sách origin được phép (phân tách bằng dấu phẩy).
# DEV: dùng Vite proxy nên để *.
# PRODUCTION: ĐẶT DOMAIN THẬT, VD: CORS_ORIGIN=https://shop.example.com,https://admin.example.com
CORS_ORIGIN=*

# ---- Gemini (nhận diện thực đơn từ ảnh) ----
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Import dữ liệu từ Google Sheets ----
# Cách 1 (ĐƠN GIẢN NHẤT, khuyến nghị nếu bạn là chủ sheet): chia sẻ sheet ở chế độ
# "Bất kỳ ai có liên kết → Người xem", rồi dùng chế độ "Sheet công khai" trên giao diện
# web (menu "Import dữ liệu") hoặc --mode=public cho CLI. Không cần tạo gì trên Google Cloud.
# Cách 2: Cấu hình ngay trên giao diện web (menu "Import dữ liệu").
# Cách 3: Dùng CLI. Chọn 1 trong các cách xác thực:
#   1. Service Account (file JSON tải từ Google Cloud Console)
#      -> Chia sẻ Google Sheet với email service account (quyền Viewer)
GOOGLE_CREDENTIALS_JSON=
#   2. Hoặc Sheet public + API key
GOOGLE_API_KEY=
#   3. Sheet công khai, không cần key (tự tải XLSX): IMPORT_MODE=public
IMPORT_MODE=
# Spreadsheet ID (hoặc truyền --sheetId= khi chạy lệnh)
GOOGLE_SHEET_ID=